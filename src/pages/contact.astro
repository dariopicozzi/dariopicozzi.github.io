---
import Base from '../layouts/Base.astro';

/*
 * The form posts to a small PHP handler on my own Hostinger web hosting, which
 * relays the message to a private inbox by email. The destination address never
 * appears in the page source, and no third-party form service is involved.
 * The handler itself lives on the server (see /server/contact.php in the repo,
 * which is gitignored) — only this public endpoint URL ships to the site.
 */
const ENDPOINT = 'https://form.dariopicozzi.com/contact.php';
---

<Base title="Contact · Dario Picozzi">
  <article class="measure">
    <header class="page-head">
      <h1>Contact</h1>
      <p class="lede">
        For research questions, collaborations, or anything else, the form below reaches
        me directly. You can also find me
        on <a href="https://github.com/dariopicozzi">GitHub</a> and <a href="https://www.linkedin.com/in/dariopicozzi/">LinkedIn</a>.
      </p>
    </header>

    <form id="contact-form" action={ENDPOINT} method="POST">
      <label>
        <span>Name</span>
        <input type="text" name="name" required autocomplete="name" />
      </label>
      <label>
        <span>Email</span>
        <input type="email" name="email" required autocomplete="email" />
      </label>
      <label>
        <span>Message</span>
        <textarea name="message" rows="7" required></textarea>
      </label>
      <!-- honeypot: real people leave this blank; bots tend to fill it.
           Deliberately not called "website", as password managers autofill that,
           which would silently discard a genuine message. -->
      <div class="hp" aria-hidden="true">
        <label>Leave this field empty
          <input type="text" name="hp_ref" tabindex="-1" autocomplete="off" />
        </label>
      </div>
      <button type="submit">Send message</button>
      <p id="form-status" role="status" aria-live="polite"></p>
    </form>

    <!-- replaces the form once a message has gone through -->
    <div id="contact-sent" class="sent" role="status" aria-live="polite" tabindex="-1" hidden>
      <p class="sent-lead">Thank you for getting in touch.</p>
      <p class="sent-sub">Your message has been sent.</p>
    </div>
  </article>
</Base>

<style>
  .page-head { margin-block: 3.2rem 2.4rem; }
  .lede { color: var(--ink-soft); }
  form {
    display: grid;
    gap: 1.2rem;
    max-width: 34rem;
    margin-bottom: 3rem;
  }
  /* display:grid above would otherwise beat the default [hidden] rule */
  form[hidden] { display: none; }
  label { display: grid; gap: 0.35rem; }
  label span { font-size: 0.88rem; color: var(--ink-soft); }
  input,
  textarea {
    font: inherit;
    color: var(--ink);
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 0.65em 0.85em;
  }
  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--ink-soft);
  }
  button {
    justify-self: start;
    font: inherit;
    font-weight: 500;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--ink-faint);
    border-radius: 10px;
    padding: 0.65em 1.5em;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  button:hover {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }
  button:disabled { opacity: 0.6; cursor: default; }
  button:disabled:hover { background: transparent; color: var(--ink); border-color: var(--ink-faint); }

  /* honeypot — kept out of view and out of the tab order */
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  #form-status { margin: 0; min-height: 1.2em; font-size: 0.92rem; }
  #form-status.is-ok { color: var(--ink); }
  #form-status.is-error { color: #e5736a; }

  /* confirmation panel, shown in place of the form */
  .sent {
    max-width: 34rem;
    margin-bottom: 3rem;
    padding: 1.5rem 1.6rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--bg-raised);
    outline: none;
  }
  .sent[hidden] { display: none; }
  .sent-lead { margin: 0 0 0.4em; color: var(--ink); }
  .sent-sub { margin: 0; color: var(--ink-soft); font-size: 0.92rem; }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    const status = document.getElementById('form-status')!;
    const sent = document.getElementById('contact-sent')!;
    const button = form.querySelector('button')!;
    const label = button.textContent;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.className = '';
      status.textContent = '';
      button.disabled = true;
      button.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new URLSearchParams(new FormData(form) as any),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          // swap the form out for the confirmation
          form.reset();
          form.hidden = true;
          sent.hidden = false;
          sent.focus();
          return;
        } else {
          status.classList.add('is-error');
          status.textContent = data.error || 'Something went wrong. Please try again.';
        }
      } catch {
        status.classList.add('is-error');
        status.textContent = 'Could not reach the server. Please try again shortly.';
      } finally {
        button.disabled = false;
        button.textContent = label;
      }
    });
  }
</script>
