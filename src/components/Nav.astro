---
const links = [
  { href: '/publications/', label: 'Publications' },
  { href: '/software/', label: 'Software' },
  { href: '/talks/', label: 'Talks' },
  { href: '/background/', label: 'Background' },
  { href: '/contact/', label: 'Contact' },
];
const current = Astro.url.pathname;
---

<header class="site-header">
  <nav class="wide">
    <a class="wordmark" href="/">Dario&nbsp;Picozzi</a>
    <div class="links">
      {
        links.map(({ href, label }) => (
          <a href={href} aria-current={current === href ? 'page' : undefined}>
            {label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    padding-block: 0.85rem;
  }
  .wordmark {
    font-weight: 350;
    letter-spacing: 0.01em;
    font-size: 1.1rem;
    color: var(--ink);
  }
  .wordmark:hover { text-decoration: none; }
  .links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
  }
  .links a {
    color: var(--ink-soft);
    font-size: 0.93rem;
  }
  .links a:hover { color: var(--ink); text-decoration: none; }
  .links a[aria-current='page'] { color: var(--ink); font-weight: 450; }

  @media (max-width: 560px) {
    .links { gap: 0.5rem 0.9rem; }
    .links a { font-size: 0.85rem; }
  }
</style>
